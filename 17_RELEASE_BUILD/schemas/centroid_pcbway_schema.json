{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PCBWay Centroid CSV Schema",
  "type": "object",
  "required_columns": ["Designator", "Mid X", "Mid Y", "Rotation", "Layer"],
  "required_nonblank": ["Designator", "Mid X", "Mid Y", "Rotation", "Layer"],
  "numeric_columns": ["Mid X", "Mid Y", "Rotation"],
  "layer_column": "Layer",
  "allowed_layers": ["Top", "Bottom"],
  "notes": "PCBWay centroid usually lists SMD placement data."
}
